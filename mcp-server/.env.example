# ============================================
# Nanobanana MCP Server - Environment Variables
# ============================================

# ============================================
# PROVIDER SELECTION (Choose ONE)
# ============================================

# Option 1: Grok2API (Recommended for local image generation)
# Supports: grok-imagine-1.0, grok-imagine-1.0-fast, grok-imagine-1.0-edit
# Supports: grok-3, grok-4, grok-4.1 models for analysis
GROK_API_BASE_URL=http://localhost:8011
GROK_API_KEY=your-grok-api-key

# Option 2: Local Proxy (Gemini format)
# OPENAI_API_BASE=http://localhost:8080
# OPENAI_API_KEY=your-proxy-key

# Option 3: Google Gemini API (Direct)
# NANOBANANA_GEMINI_API_KEY=your-gemini-key
# GEMINI_API_KEY=your-gemini-key
# GOOGLE_API_KEY=your-google-key

# ============================================
# MODEL CONFIGURATION
# ============================================

# Grok Image Generation Models
# Options: grok-imagine-1.0, grok-imagine-1.0-fast (default)
GROK_IMAGE_MODEL=grok-imagine-1.0-fast

# Grok Image Editing Model
# Options: grok-imagine-1.0-edit (default)
GROK_EDIT_MODEL=grok-imagine-1.0-edit

# Grok Analysis Model (for image analysis)
# Options: grok-3, grok-3-mini, grok-4 (default), grok-4-thinking, grok-4.1-fast
GROK_ANALYZER_MODEL=grok-4

# Gemini Models (when using Gemini provider)
# NANOBANANA_MODEL=gemini-3-pro-image-preview
# NANOBANANA_ANALYZER_MODEL=gemini-2.5-flash

# ============================================
# OUTPUT CONFIGURATION
# ============================================

# Output directory for generated images
IMAGE_OUTPUT_DIR=./nanobanana-output

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================
# GROK2API MODEL REFERENCE
# ============================================

# Image Generation:
# - grok-imagine-1.0: Standard quality, single image
# - grok-imagine-1.0-fast: Fast generation, supports 1-10 images

# Image Editing:
# - grok-imagine-1.0-edit: Edit existing images

# Chat/Analysis (with vision support):
# - grok-3: Standard Grok 3
# - grok-3-mini: Faster, lightweight
# - grok-3-thinking: With reasoning
# - grok-4: Latest Grok 4 (recommended for analysis)
# - grok-4-thinking: Grok 4 with reasoning
# - grok-4-heavy: Most powerful
# - grok-4.1-mini, grok-4.1-fast, grok-4.1-expert
# - grok-4.20-beta: Beta version

# ============================================
# USAGE EXAMPLES
# ============================================

# Example 1: Grok2API for everything
# GROK_API_BASE_URL=http://localhost:8011
# GROK_API_KEY=your-key
# GROK_IMAGE_MODEL=grok-imagine-1.0-fast
# GROK_ANALYZER_MODEL=grok-4

# Example 2: Mixed providers
# GROK_API_BASE_URL=http://localhost:8011  # For image generation
# GROK_API_KEY=your-key
# GROK_ANALYZER_MODEL=grok-4  # For analysis

# Example 3: Gemini only
# NANOBANANA_GEMINI_API_KEY=your-gemini-key
# NANOBANANA_MODEL=gemini-3-pro-image-preview
# NANOBANANA_ANALYZER_MODEL=gemini-2.5-flash
