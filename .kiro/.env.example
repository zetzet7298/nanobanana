# ============================================================
# Nano Banana MCP Server - Kiro Environment Variables
# ============================================================
# Copy this file to ~/.env or load it before starting Kiro
# Usage: source ~/.env

# ============================================================
# Gemini API Configuration (Required for Gemini models)
# ============================================================
# Get your API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# Grok2API Configuration (Optional - for local provider)
# ============================================================
# Grok2API server URL (default: http://localhost:8011)
GROK_API_BASE_URL=http://localhost:8011

# Grok2API authentication key (optional)
GROK_API_KEY=your-grok-api-key

# Grok Image Generation Model (default: grok-imagine-1.0-fast)
# Options:
#   - grok-imagine-1.0: Standard image generation
#   - grok-imagine-1.0-fast: Faster, supports multiple images (1-10)
GROK_IMAGE_MODEL=grok-imagine-1.0-fast

# Grok Image Editing Model (default: grok-imagine-1.0-edit)
GROK_EDIT_MODEL=grok-imagine-1.0-edit

# ============================================================
# Model Selection
# ============================================================
# Options: auto, flash, nb2, pro, grok
# - auto: Intelligent selection (default to nb2)
# - flash: Gemini 2.5 Flash (fast, 1024px)
# - nb2: Gemini 3.1 Flash Image (4K at Flash speed) - DEFAULT
# - pro: Gemini 3 Pro Image (4K, max quality)
# - grok: Grok2API (local, 1-10 images)
NANOBANANA_MODEL=auto

# ============================================================
# Output Configuration
# ============================================================
# Directory for generated images (default: ~/nanobanana-images)
IMAGE_OUTPUT_DIR=${HOME}/nanobanana-images

# Return full-resolution images in MCP response (default: false)
# WARNING: Full images can be 3-7MB each for 4K
RETURN_FULL_IMAGE=false

# ============================================================
# Logging Configuration
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: standard, json, detailed
LOG_FORMAT=standard

# ============================================================
# Advanced Configuration (Optional)
# ============================================================

# Vertex AI Authentication (Google Cloud)
# NANOBANANA_AUTH_METHOD=vertex_ai
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# Custom Gemini API endpoint (for proxies/gateways)
# GEMINI_BASE_URL=https://custom-api.example.com

# Gemini Pro Model Settings
# GEMINI_PRO_THINKING_LEVEL=high  # low, high
# GEMINI_PRO_ENABLE_GROUNDING=true

# ============================================================
# Quick Setup Commands
# ============================================================
# 1. Copy this file:
#    cp .kiro/.env.example ~/.env
#
# 2. Edit with your values:
#    nano ~/.env
#
# 3. Load environment:
#    source ~/.env
#
# 4. Verify:
#    echo $GEMINI_API_KEY
#    echo $GROK_API_BASE_URL
#
# 5. Start Kiro:
#    kiro /var/www/nanobanana-mcp-server
